# Google Gemini AI Configuration
# Get a free Gemini API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Active Bibliographic Catalogue Provider
# Options: "openlibrary" | "demo" | "koha"
CATALOGUE_PROVIDER=openlibrary

# Official Koha OPAC Configuration for NFSU
KOHA_OPAC_URL=https://catalog.nfsu.ac.in
KOHA_API_ENDPOINT=https://catalog.nfsu.ac.in/api/v1
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=
