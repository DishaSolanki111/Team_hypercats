# Google Gemini API Key for AI Reasoning & Intent Recognition
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# Active Catalogue Provider: "openlibrary" | "demo" | "koha"
# (Defaults to "openlibrary" with automatic fallback to curated forensic demo dataset)
CATALOGUE_PROVIDER=openlibrary

# Official Koha OPAC URL for National Forensic Sciences University
KOHA_OPAC_URL=https://catalog.nfsu.ac.in

# Future Koha Integration (Leave empty until authorized credentials are provided by NFSU IT)
KOHA_API_ENDPOINT=https://catalog.nfsu.ac.in/api/v1
KOHA_CLIENT_ID=
KOHA_CLIENT_SECRET=
